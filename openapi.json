{
  "openapi": "3.1.0",
  "info": {
    "title": "ystt API",
    "description": "Authenticated, in-memory TikTok + SoundCloud download API. All /v1 endpoints require a Bearer key.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.5.0"
  },
  "servers": [
    {
      "url": "https://ystt.d9v.uk/api"
    }
  ],
  "paths": {
    "/v1/batch": {
      "post": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Download a bounded batch.",
        "operationId": "batch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/download": {
      "post": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Download one post.",
        "operationId": "download",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/health": {
      "get": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Health/authentication probe.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/media/{token}": {
      "get": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Download one media token.",
        "operationId": "media",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "description": "Media token returned by /v1/download",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Media bytes",
            "content": {
              "application/octet-stream": {}
            }
          },
          "206": {
            "description": "Partial media bytes",
            "content": {
              "application/octet-stream": {}
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "416": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Generated OpenAPI schema.",
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "OpenAPI 3 schema"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/resolve": {
      "post": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Resolve metadata only.",
        "operationId": "resolve",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    },
    "/v1/stats": {
      "get": {
        "tags": [
          "crate::routes"
        ],
        "summary": "Media-store and queue statistics.",
        "operationId": "stats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer_auth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Author": {
        "type": "object",
        "description": "Post author.",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "TikTok unique ID (handle)."
          },
          "nickname": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name when present."
          }
        }
      },
      "BatchItem": {
        "type": "object",
        "description": "One batch item.",
        "required": [
          "index",
          "url"
        ],
        "properties": {
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ErrorBody",
                "description": "Failure details."
              },
              {
                "type": "null"
              }
            ]
          },
          "index": {
            "type": "integer",
            "description": "Zero-based input index.",
            "minimum": 0
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DownloadResponse",
                "description": "Success result."
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string",
            "description": "Input URL."
          }
        }
      },
      "BatchRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DownloadOptionsInput",
            "description": "Shared per-request download policy."
          },
          {
            "type": "object",
            "required": [
              "urls"
            ],
            "properties": {
              "concurrency": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Per-item concurrency (server-capped).",
                "minimum": 0
              },
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "URLs in input order."
              }
            }
          }
        ],
        "description": "Download several posts with bounded concurrency."
      },
      "BatchResponse": {
        "type": "object",
        "description": "Batch response in input order.",
        "required": [
          "items",
          "successes",
          "failures",
          "total_ms"
        ],
        "properties": {
          "failures": {
            "type": "integer",
            "description": "Failed item count.",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "description": "Ordered items."
          },
          "successes": {
            "type": "integer",
            "description": "Successful item count.",
            "minimum": 0
          },
          "total_ms": {
            "type": "integer",
            "format": "int64",
            "description": "End-to-end milliseconds.",
            "minimum": 0
          }
        }
      },
      "Bitrate": {
        "type": "object",
        "description": "One selectable video stream.",
        "required": [
          "bitrate"
        ],
        "properties": {
          "bitrate": {
            "type": "integer",
            "format": "int64",
            "description": "Declared bitrate in bits per second.",
            "minimum": 0
          },
          "codec": {
            "type": [
              "string",
              "null"
            ],
            "description": "Codec name (`h264`, `bytevc1`, ...)."
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Stream height, when known.",
            "minimum": 0
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stream URL."
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Stream width, when known.",
            "minimum": 0
          }
        }
      },
      "DownloadOptionsInput": {
        "type": "object",
        "description": "Per-request download policy.",
        "properties": {
          "adaptive_ranges": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Adapt range concurrency while downloading."
          },
          "allow_partial": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Allow individual gallery/audio failures."
          },
          "include_audio": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Include the post's music track."
          },
          "max_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Maximum bytes for any one media item.",
            "minimum": 0
          },
          "max_connections": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Maximum range connections.",
            "minimum": 0
          },
          "media_retries": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Per-media retry budget.",
            "minimum": 0
          },
          "parallel_ranges": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Use parallel CDN ranges for large videos."
          },
          "photo_concurrency": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Maximum gallery concurrency.",
            "minimum": 0
          },
          "quality": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QualityPolicy",
                "description": "Video stream policy. Defaults to the server policy."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "DownloadRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DownloadOptionsInput",
            "description": "Per-request download policy."
          },
          {
            "type": "object",
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "description": "TikTok post, short-link or share URL."
              }
            }
          }
        ],
        "description": "Download one post."
      },
      "DownloadResponse": {
        "type": "object",
        "description": "Full result of an in-memory download.",
        "required": [
          "provider",
          "post_id",
          "source_url",
          "page_url",
          "author",
          "photos",
          "failures",
          "timings",
          "cache_hit"
        ],
        "properties": {
          "artwork": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MediaDescriptor",
                "description": "Authenticated artwork bytes (SoundCloud)."
              },
              {
                "type": "null"
              }
            ]
          },
          "artwork_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Square artwork URL (SoundCloud)."
          },
          "audio": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MediaDescriptor",
                "description": "Music/audio when present."
              },
              {
                "type": "null"
              }
            ]
          },
          "author": {
            "$ref": "#/components/schemas/Author",
            "description": "Author/performer."
          },
          "cache_hit": {
            "type": "boolean",
            "description": "Always false for the in-memory API."
          },
          "cover_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cover/artwork URL."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Caption/description."
          },
          "failures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartialFailure"
            },
            "description": "Partial failures."
          },
          "page_url": {
            "type": "string",
            "description": "Canonical page URL."
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MediaDescriptor"
            },
            "description": "Gallery photos in order."
          },
          "playlist": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PlaylistDescriptor",
                "description": "SoundCloud playlist when the input was a set."
              },
              {
                "type": "null"
              }
            ]
          },
          "post_id": {
            "type": "string",
            "description": "Post or track ID."
          },
          "provider": {
            "$ref": "#/components/schemas/Provider",
            "description": "Source provider."
          },
          "source_url": {
            "type": "string",
            "description": "Original input URL."
          },
          "timings": {
            "$ref": "#/components/schemas/Timings",
            "description": "Stage timings."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Media title (SoundCloud track/playlist title)."
          },
          "video": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/MediaDescriptor",
                "description": "Video when present."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Stable machine-readable error payload.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Envelope returned for every non-2xx response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "Error details."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Liveness/readiness response.",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Service state."
          },
          "version": {
            "type": "string",
            "description": "Crate version."
          }
        }
      },
      "ImageDimensions": {
        "type": "object",
        "description": "Image dimensions.",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "height": {
            "type": "integer",
            "format": "int32",
            "description": "Height in pixels.",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "format": "int32",
            "description": "Width in pixels.",
            "minimum": 0
          }
        }
      },
      "MediaDescriptor": {
        "type": "object",
        "description": "One media object in the response. Fetch bytes from `url` with the same Bearer key.",
        "required": [
          "token",
          "url",
          "kind",
          "mime",
          "ext",
          "size",
          "sha256",
          "source_url"
        ],
        "properties": {
          "artist": {
            "type": [
              "string",
              "null"
            ],
            "description": "Artist/performer for audio media."
          },
          "duration_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Duration for video/audio media.",
            "minimum": 0
          },
          "ext": {
            "type": "string",
            "description": "Extension without a dot."
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Height for video/photo media.",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/MediaKind",
            "description": "Media kind."
          },
          "mime": {
            "type": "string",
            "description": "MIME type."
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the payload."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Size in bytes.",
            "minimum": 0
          },
          "source_url": {
            "type": "string",
            "description": "Original CDN URL."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Track title for audio media."
          },
          "token": {
            "type": "string",
            "description": "Short-lived opaque media token."
          },
          "url": {
            "type": "string",
            "description": "Authenticated media URL."
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Width for video/photo media.",
            "minimum": 0
          }
        }
      },
      "MediaInfo": {
        "type": "object",
        "description": "Resolved media metadata for one post, ready to download.",
        "required": [
          "post_id",
          "source_url",
          "page_url",
          "author",
          "photo_urls",
          "photo_dimensions",
          "is_slideshow",
          "is_age_restricted",
          "bitrates"
        ],
        "properties": {
          "audio_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Music URL."
          },
          "author": {
            "$ref": "#/components/schemas/Author",
            "description": "Author."
          },
          "bitrates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Bitrate"
            },
            "description": "Available video bitrates."
          },
          "cover_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cover image URL, when known."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Caption."
          },
          "duration_sec": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Default video duration in seconds.",
            "minimum": 0
          },
          "is_age_restricted": {
            "type": "boolean",
            "description": "Whether TikTok marks the post as age-restricted."
          },
          "is_slideshow": {
            "type": "boolean",
            "description": "Whether the post is a photo slideshow."
          },
          "music": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Music",
                "description": "Music metadata."
              },
              {
                "type": "null"
              }
            ]
          },
          "page_url": {
            "type": "string",
            "description": "Canonical TikTok page URL."
          },
          "photo_dimensions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ImageDimensions"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Dimensions for each photo URL, when known."
          },
          "photo_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Selected photo URLs in gallery order."
          },
          "post_id": {
            "type": "string",
            "description": "Post ID."
          },
          "source_url": {
            "type": "string",
            "description": "Original user input."
          },
          "video_height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Default video height.",
            "minimum": 0
          },
          "video_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Selected video URL."
